# RaipurNetra AI — environment configuration
# Copy to `.env` (or set as system env vars) and adjust.
# The app reads these via backend/settings.py.

# --- server
RN_HOST=0.0.0.0
RN_PORT=8000
RN_LOG_LEVEL=INFO
# keep 1: the simulation engine is in-process (see DEPLOYMENT.md for scaling)
RN_WORKERS=1

# --- vision (Layer 1)
RN_YOLO_CONF=0.30
RN_VISION_FRAME_INTERVAL=0.5
RN_VISION_MAX_UPLOAD_MB=200

# --- prediction (Layer 2)
RN_RETRAIN_MIN=15

# --- WhatsApp Cloud API (Layer 4)
# Get these from https://developers.facebook.com -> your App -> WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=raipurnetra-verify-2026

# --- map tiles (frontend Leaflet) — keyless Esri dark canvas by default;
# alternatives: OSM https://tile.openstreetmap.org/{z}/{x}/{y}.png
RN_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
RN_TILE_ATTR=Tiles &copy; Esri
